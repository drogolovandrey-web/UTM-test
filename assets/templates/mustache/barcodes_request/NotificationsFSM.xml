<ns:Documents xmlns:oref="http://fsrar.ru/WEGAIS/ClientRef_v2"
              xmlns:rpp="http://fsrar.ru/WEGAIS/{{notificationType}}"
              xmlns:ns="http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01"
              xmlns:xsi="http://www.w3.org/2">
        <ns:Owner>
                <ns:FSRAR_ID>{{fsrarId}}</ns:FSRAR_ID>
        </ns:Owner>
  <ns:Document>
    <ns:{{notificationType}}>
      <rpp:Identity>1</rpp:Identity>
      <rpp:Header>
        <rpp:NUMBER>{{notificationNumber}}</rpp:NUMBER>
        <rpp:Date>{{notificationDate}}</rpp:Date>
        <rpp:Declarer>
          <oref:{{orgType}}>
          {{#declarer}}
            <oref:ClientRegId>{{clientRegId}}</oref:ClientRegId>
            <oref:INN>{{inn}}</oref:INN>
            {{#kpp}}<oref:KPP>{{kpp}}</oref:KPP>{{/kpp}}
            <oref:FullName>{{fullName}}</oref:FullName>
            {{#address_ur}}
            <oref:address_ur>
              <oref:Country>{{country}}</oref:Country>
              <oref:RegionCode>{{regionCode}}</oref:RegionCode>
              <oref:description>{{description}}</oref:description>
            </oref:address_ur>
            {{/address_ur}}
            {{#address}}
            <oref:address>
              <oref:Country>{{country}}</oref:Country>
              <oref:RegionCode>{{regionCode}}</oref:RegionCode>
              <oref:description>{{description}}</oref:description>
            </oref:address>
            {{/address}}
            {{/declarer}}
          </oref:{{orgType}}>
        </rpp:Declarer>
      <rpp:RequestNUMBER>{{requestNumber}}</rpp:RequestNUMBER>
      <rpp:RequestDate>{{requestDate}}</rpp:RequestDate>
      <rpp:RequestFSM>{{requestFSM}}</rpp:RequestFSM>
      <rpp:Comment>{{comment}}</rpp:Comment>
      </rpp:Header>
    </ns:{{notificationType}}>
  </ns:Document>
</ns:Documents>
